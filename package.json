{
  "name": "koncite-web-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=8192 node server.js",
    "dev:turbo": "cross-env NODE_ENV=development TURBO=1 NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=8192 node server.js",
    "dev:next": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=8192 next dev --turbo",
    "dev:webpack": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev:clean": "npm run clean && npm run dev",
    "dev:clean:turbo": "npm run clean && npm run dev:turbo",
    "build": "npm run clean && cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "next lint",
    "test:api": "node scripts/test-api-endpoints.js"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.13.4",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "^15.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2"
  }
}
