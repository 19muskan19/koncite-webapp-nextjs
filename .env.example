# --- Azure OpenAI (session titles / summaries via `lib/azureSessionMeta.ts`) ---
# Same layout as Python: AzureOpenAI(azure_endpoint, api_key, api_version) + deployment model name.
# Copy to `.env.local` and fill secrets. Do not commit `.env.local`.

# --- Proxy + tender SSR base (`/api-proxy/*` and `components/ai-tendering/api.ts` server-side URLs) ---
# Must include `/api` once (never `…/api//…`). Tender calls use `{base}/tender/...` by default.
# NEXT_PUBLIC_API_URL=https://staging.koncite.com/api
# Legacy servers with flat `/api/process` (no `/tender` segment): NEXT_PUBLIC_TENDER_AUX_PREFIX=flat
# If unset: defaults to https://staging.koncite.com/api — restart `next dev` after edits.
# Local FastAPI example: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Optional tertiary fallback for SSR only — prefer NEXT_PUBLIC_API_URL so rewrites stay in sync.
# NEXT_PUBLIC_AI_TENDER_API=http://staging.koncite.com/api

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Completion options — defaults match Python sample (temperature 1, top_p 1, penalties 0, max_completion_tokens 13107)
AZURE_OPENAI_TEMPERATURE=1
AZURE_OPENAI_TOP_P=1
AZURE_OPENAI_FREQUENCY_PENALTY=0
AZURE_OPENAI_PRESENCE_PENALTY=0
AZURE_OPENAI_MAX_COMPLETION_TOKENS=13107
